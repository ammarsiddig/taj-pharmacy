{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TAJ Pharmacy",
  "version": "0.2.5",
  "identifier": "com.taj.pharmacy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TAJ Pharmacy",
        "width": 1280,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklFTXdRak0yTmpORlF6STVOalEzTWtFS1VsZFJjVkkxWWtOUWJXRjZkMEZUVURsVVVtTTNaMDR5T0dGWU4wRjVMM0kwVEROT2FYVnJXRVZ4YVc5RFpucHpVVTlZY0RWaGF5OEs=",
      "endpoints": [
        "https://github.com/ammarsiddig/taj-pharmacy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
