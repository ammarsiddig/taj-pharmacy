# LEGACY ONLY - NOT ACTIVE IN PRODUCTION
#
# Current production uses host-level Nginx, not this Caddyfile.
# Source of truth: docs/AGENT-HANDOFF.md, section
# "Production Domain and Reverse Proxy Setup".
#
# Do not run pms-caddy on ports 80/443 while Nginx is active.
# The production backend must stay private at 127.0.0.1:3000.
#
# This file is retained only for rollback/reference under the
# docker-compose `legacy-caddy` profile.

:80 {
    handle /v1/* {
        reverse_proxy api:3000
    }
    handle /admin/* {
        reverse_proxy api:3000
    }
    handle /auth/* {
        reverse_proxy api:3000
    }
    handle /health {
        reverse_proxy api:3000
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
